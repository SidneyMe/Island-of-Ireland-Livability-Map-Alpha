# Copy this file to .env and replace placeholders with local values.

# Option A: single SQLAlchemy/PostGIS connection URL.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database_name

# Option B: split PostgreSQL connection settings.
# Comment out DATABASE_URL above if you prefer these values.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=database_name
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password

# Optional local tool overrides.
OSM2PGSQL_BIN=osm2pgsql
# osm2pgsql memory tuning. Defaults run in-RAM with a 2048 MB node cache
# (~3 GB peak including osm2pgsql overhead) — fits comfortably in laptops
# with 8 GB+ free and is much faster than the disk-backed alternative.
# If you hit `bad allocation` or are memory-constrained, opt into the
# disk-backed flat-nodes file (~1GB, slower but low-RAM):
# OSM2PGSQL_FLAT_NODES=osm/flat-nodes.bin
# OSM2PGSQL_CACHE_MB=2048
# OSM2PGSQL_NUMBER_PROCESSES=1
# Windows:
# WALKGRAPH_BIN=walkgraph/target/release/walkgraph.exe
# Linux/macOS:
# WALKGRAPH_BIN=walkgraph/target/release/walkgraph

# GTFS feeds (required for transport scoring).
# Download the static GTFS zips from the operator portals and place them at:
#   NTA (ROI):       https://www.transportforireland.ie/transitData/PT_Data.html
#   Translink (NI):  https://admin.opendatani.gov.uk/group/transport
# Local zip paths are the primary ingestion path. URL values are optional and
# are only used when you want the pipeline to refresh the local zip first
# (python main.py transit --auto-refresh-gtfs).
# GTFS_NTA_ZIP_PATH=gtfs/nta_gtfs.zip
# GTFS_TRANSLINK_ZIP_PATH=gtfs/translink_gtfs.zip
# GTFS_NTA_URL=
# GTFS_TRANSLINK_URL=
# GTFS_AS_OF_DATE=2026-04-14
# GTFS_ANALYSIS_WINDOW_DAYS=30
# GTFS_SERVICE_DESERT_WINDOW_DAYS=7
# Missing/broken GTFS yields zero transport signal; precompute refuses to
# publish such a build unless --allow-missing-transport is passed.

# Dataset URLs for setup.sh. Export them before invoking the script (for
# example: set -a; . ./.env; set +a; ./setup.sh). The script reuses an existing
# local file, and only downloads a dataset whose URL is set. Boundary and GTFS
# inputs are required for a full build; Overture, the main-island shapefile,
# and noise are optional. setup.sh has public fallback URLs for the two
# required boundaries. Use release-file URLs rather than portal landing-page
# URLs for every other source.
#
# Recommended: upload the files below as assets in a GitHub Release, then set
# this to its release-asset base URL. Example:
# DATASET_MIRROR_BASE_URL=https://github.com/YOUR-ORG/livability-data/releases/download/v1
# The script uses this mirror before public defaults. Individual URL variables
# below still override the mirror when necessary.
# ROI_BOUNDARY_URL=  # Optional override.
# NI_BOUNDARY_URL=   # Optional override; default is a GitHub NI coastline mirror.
# NI_BOUNDARY_FALLBACK_URL=  # Optional override if the primary source is unavailable.
# OVERTURE_PLACES_URL=
# MAIN_ISLAND_BOUNDARY_ARCHIVE_URL=
# NOISE_ROUND4_URL=
# NOISE_ROUND3_URL=
# NOISE_ROUND2_URL=
# NOISE_NI_ROUND3_URL=
# NOISE_NI_ROUND2_URL=
# NOISE_NI_ROUND1_URL=

# Noise engine:
# NOISE_MODE=artifact is default.
# legacy is debug-only and slow.
# NOISE_MODE=artifact
# Windows workflow:
# fast reuse-only loop:
#   scripts\win\precompute_noise_dev.cmd
# slow artifact prepare:
#   scripts\win\prepare_noise_artifact_dev.cmd
#   scripts\win\prepare_noise_artifact_accurate.cmd

# Noise accuracy:
# dev_fast is default: exact airport/industry, coarse grid road/rail.
# accurate: exact airport/industry, simplified polygon road/rail.
# CLI --noise-accurate wins over env.
# NOISE_ACCURACY_MODE=dev_fast
# NOISE_GRID_SIZE_M=1000
# NOISE_DEV_FAST_MIN_GRID_SIZE_M=500
# NOISE_DEV_FAST_READ_CHUNK_SIZE=25
# NOISE_DEV_FAST_MAX_CELLS_PER_FEATURE=250000
# NOISE_ALLOW_TINY_NOISE_GRID=0
# NOISE_ACCURATE_SIMPLIFY_M=25

# GDAL/ogr2ogr:
# Windows: use scripts\win\geo_env.cmd .\.venv\Scripts\python.exe ...
# NOISE_INGEST_MODE=ogr2ogr
# NOISE_OGR2OGR_HARD_TIMEOUT_SECONDS=900
# NOISE_OGR2OGR_NO_PROGRESS_TIMEOUT_SECONDS=180
# NOISE_OGR2OGR_GDB_WORKERS=1
# NOISE_OGR2OGR_GDB_CHUNK_SIZE=25

# Disk guards:
# accurate needs more temporary PostGIS/GDAL space than dev_fast.
# NOISE_MIN_FREE_DISK_GB=30
# NOISE_DEV_FAST_MIN_FREE_DISK_GB=10
# DevReuse performance contract:
# target under 10 minutes; hard cap 20 minutes.
